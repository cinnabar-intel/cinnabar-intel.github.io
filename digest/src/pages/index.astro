    profile: "E3 T-Ac U2 H-Ah Z-Now",
    strength: "strong",
    logic: {
      what: "Moonshot's Kimi K3.1 Pro scored 55 on the Artificial Analysis index at $2 and $10 per million tokens.",
      mechanism: "If the promised weights ship, the open-versus-proprietary gap shrinks from twelve index points to three, adding price-performance leverage.",
      soWhat: "Enterprise buyers gain negotiating leverage and a credible open-weight option for data-residency cases, if the weights arrive.",
    },
