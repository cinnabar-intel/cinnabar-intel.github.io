        url: "https://www.latent.space/p/ainews-openais-patch-the-planet-program",
      },
      {
        label: "analyticsindiamag.com/ai-trends/internet-on-alert-as-ai-uncovers-critical-flaws-in-php-used-by-70-of-websites",
        url: "https://analyticsindiamag.com/ai-trends/internet-on-alert-as-ai-uncovers-critical-flaws-in-php-used-by-70-of-websites",
      },
      {
        label: "thezvi.substack.com/p/ai-191-the-hackening-begins",
        url: "https://thezvi.substack.com/p/ai-191-the-hackening-begins",
      },
    ],
  },
  {
    index: 2,
    date: "2026-10-20",
    category: "01 GenAI Capabilities · 03 Workforce & Human-AI Collaboration",
    title:
      "Mollick charts METR's task-horizon yardstick saturating while cost per correct answer falls roughly seven hundred fifty fold.",
    profile: "E4 T-Ac U3 H-Gr Z-Now",
    strength: "strong",
    logic: {
      what: "Mollick charts METR's task horizon doubling eight times, and METR reportedly can no longer measure it reliably.",
      mechanism: "The yardstick is saturating, not only the capability, so benchmark-defined agent horizons lose reliability at the top end.",
      soWhat: "Planning that relies on benchmark-defined agent capacity needs a different yardstick, since the current one no longer measures the top end.",
    },
    sources: [
      {
        label: "oneusefulthing.org/p/30-months-on-the-exponential-in-charts",
        url: "https://www.oneusefulthing.org/p/30-months-on-the-exponential-in-charts",
