    logic: {
      what: "Infosys reported AI revenue up 29% quarter-on-quarter, now 10.5% of revenue, while cutting FY27 growth guidance to 1% to 2%.",
      mechanism: "AI-native revenue is growing fast but is not yet offsetting deflation in the traditional services base.",
      soWhat: "Services strategies should model AI revenue and core-base pricing pressure separately, since one does not yet cover the other.",
    },
    sources: [
      {
        label: "analyticsindiamag.com/ai-news/infosys-ai-revenue-rises-29-in-q2-fy27-growth-guidance-cut",
