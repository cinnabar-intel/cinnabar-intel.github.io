---
import { existsSync } from "node:fs";
import { join } from "node:path";

import Issue from "../layouts/Issue.astro";
import Masthead from "../components/Masthead.astro";
import HeroThesis from "../components/HeroThesis.astro";
import AudioBrief from "../components/AudioBrief.astro";
import ClusterCallout from "../components/ClusterCallout.astro";
import SignalIndex from "../components/SignalIndex.astro";
import Synthesis from "../components/Synthesis.astro";
import Signal from "../components/Signal.astro";
import type { SignalLogic } from "../components/SignalSpine.astro";
import Methodology from "../components/Methodology.astro";
import PreviousIssues from "../components/PreviousIssues.astro";

const issueDate = "2026-10-26";
const description =
  "Between October 20 and 23, two security teams independently used frontier models to find the same remote code execution flaws in PHP and a leak collapsed the disclosure embargo; Ethan Mollick charted METR's task-horizon yardstick saturating while cost per correct answer fell roughly seven hundred fifty fold; Moonshot's Kimi K3.1 Pro reached fourth on the Artificial Analysis index at two dollars and ten dollars per million tokens; Infosys reported AI revenue up twenty-nine percent in a quarter while cutting its growth guidance; and the Pragmatic Engineer found that most of twenty-seven companies cannot yet measure the return on AI spend. The week's thesis: capability and cost curves are now moving faster than the institutions built to measure, disclose, and price them.";
const title = "The Cinnabar Dispatch · 2026-10-26 · Possibilities with Probabilities";

// Audio brief is graceful: renders if MP3 exists at the expected path, else nothing.
// Path is checked at build time against the public/ directory.
const audioFilename = `${issueDate}.mp3`;
const audioFsPath = join(process.cwd(), "public", "audio", audioFilename);
const audioPath = existsSync(audioFsPath)
  ? `${import.meta.env.BASE_URL}audio/${audioFilename}`
  : null;

// Single source of truth for signal metadata. The scannable SignalIndex and
// the full Signal detail blocks both read from this array, so the index number,
// title, profile, and strength never drift. The why/watch prose stays in each
// Signal's slots below (it does not belong in a data array).
type Strength = "strong" | "weak";
interface SignalMeta {
  index: number;
  date: string;
  category: string;
  title: string;
  profile: string;
  strength: Strength;
  sources: { label: string; url: string }[];
  // 3-beat causal spine. Authored in the scan, distilled ONLY from this
  // signal's already-cited prose (no new claim/number/URL). Renders as a
  // visual TL;DR under the title. Optional so archived issues without a spine
  // still build; the weekly scan populates it for every current signal.
  logic?: SignalLogic;
}

const signals: SignalMeta[] = [
  {
    index: 1,
    date: "2026-10-21",
    category: "04 AI Governance & Ethics · 02 Enterprise AI & Org Transformation",
    title:
      "Two teams independently find the same web-scale PHP remote code execution flaws with frontier models, and a disclosure leak turns a two-month embargo into a mass-exploitation race.",
    profile: "E4 T-Ac U3 H-Gr Z-Now",
    strength: "strong",
    logic: {
      what: "Two teams used frontier models to find the same PHP remote-execution flaws; a leak forced an early patch.",
      mechanism: "Coordinated disclosure assumes few discoverers; parallel AI-assisted discovery collapses the embargo window and leaves slow-patching sites exposed.",
      soWhat: "Patch-latency assumptions for long-tail web estates need revisiting, because exploitation now starts within hours of a leak.",
    },
    sources: [
